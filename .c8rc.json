{
  "all": true,
  "include": [
    "src/**/*.ts",
    "shared/**/*.{ts,tsx}",
    "web/src/**/*.{ts,tsx}",
    "mobile/src/**/*.{ts,tsx}",
    "mobile/App.tsx"
  ],
  "reporter": ["text", "html", "json", "json-summary", "lcovonly"],
  "report-dir": "coverage",
  "exclude": [
    "shared/types/**",
    "**/*.d.ts",
    "web/src/main.tsx",
    "mobile/index.ts"
  ]
}
