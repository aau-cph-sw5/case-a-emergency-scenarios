{
  "$id": "metro-line.schema.json",
  "title": "Metro Line",
  "type": "object",
  "required": [
    "name",
    "stops"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "station"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "station": {
            "type": "string"
          }
        }
      }
    }
  }
}