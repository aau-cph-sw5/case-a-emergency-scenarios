{
  "$id": "error.schema.json",
  "title": "Error",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine-readable error code, e.g. SCENARIO_ALREADY_ACTIVE."
    },
    "message": {
      "type": "string",
      "description": "Human-readable explanation of the error."
    }
  }
}
