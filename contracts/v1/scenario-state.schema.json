{
  "$id": "scenario-state.schema.json",
  "title": "Scenario State",
  "type": "object",
  "required": [
    "activationId",
    "scenarioId",
    "startedAt",
    "status",
    "actor",
    "sequence",
    "deployments"
  ],
  "properties": {
    "activationId": {
      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "CLOSED"]
    },
    "actor": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "fulfills"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["UNMANNED", "PENDING", "MANNED", "CHECKED_OUT"],
            "description": "UNMANNED: no steward yet. PENDING: a steward has reported a position for the station and is on the way. MANNED: the steward has arrived. CHECKED_OUT: the steward has finished the task and left (POST /api/v1/check-out, MET-A-015). Only a MANNED deployment can be checked out."
          },
          "reportedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "arrivedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "staff": {
            "type": ["string", "null"]
          },
          "fulfills": {
            "type": "string"
          }
        }
      }
    }
  }
}
