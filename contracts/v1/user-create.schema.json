{
  "$id": "user-create.schema.json",
  "title": "User Create",
  "type": "object",
  "required": ["username", "password", "role", "lineGroup"],
  "additionalProperties": false,
  "properties": {
    "username": { "type": "string", "minLength": 1 },
    "password": { "type": "string", "minLength": 8 },
    "role": { "enum": ["STEWARD", "OPERATOR", "ADMIN"] },
    "lineGroup": { "enum": ["M1_M2", "M3_M4"] }
  }
}
