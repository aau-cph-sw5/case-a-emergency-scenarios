{
  "$id": "position-report.schema.json",
  "title": "Position Report",
  "type": "object",
  "required": ["id","staff", "station", "reportedAt"],
  "properties":{
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique client-generated report ID, reused on every retry."
    },
    "staff": {
      "type": "string"
    },
    "station": {
      "type": "string"
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
