{
  "$id": "position-report.schema.json",
  "title": "Position Report",
  "type": "object",
  "required": ["staff", "station", "reportedAt"],
  "properties": {
    "staff": {
      "type": "string"
    },
    "station": {
      "type": "string"
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "taskDone": {
      "type": "boolean",
      "description": "True when the steward has finished the task at the station (MET-A-015). Only allowed at the station of the steward's latest report."
    }
  }
}
