{
  "$id": "create-scenario-request.schema.json",
  "title": "Create Scenario Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId",
    "name",
    "lineGroup",
    "version",
    "revision",
    "patterns",
    "stationRequirements",
    "coveredSegmentIds"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "lineGroup": {
      "type": "string",
      "enum": ["M1_M2", "M3_M4"]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationType",
          "trackNumber",
          "did",
          "maximumTrains",
          "stops",
          "color"
        ],
        "properties": {
          "operationType": {
            "type": "string",
            "enum": ["PENDULUM", "ROUNDTRIP"]
          },
          "trackNumber": {
            "type": "integer",
            "enum": [1, 2, 12]
          },
          "did": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "maximumTrains": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "stops": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Display color for this operating pattern."
          }
        }
      }
    },
    "stationRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["station", "placement", "minimumStaffing", "actions"],
        "properties": {
          "station": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "string"
          },
          "minimumStaffing": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "activeDuring": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dayPattern", "startTime", "endTime"],
              "properties": {
                "dayPattern": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "endTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                }
              }
            }
          }
        }
      }
    },
    "coveredSegmentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
