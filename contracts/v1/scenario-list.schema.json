{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-list.schema.json",
  "title": "Scenario List",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "scenarioId",
      "name",
      "currentVersion"
    ],
    "properties": {
      "scenarioId": {
        "type": "string"
      },

      "name": {
        "type": "string"
      },

      "currentVersion": {
        "type": "string"
      }
    }
  }
}