{
  "$id": "scenario-list.schema.json",
  "title": "Scenario List",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["scenarioId", "name", "currentVersion", "covers", "versions"],
    "properties": {
      "scenarioId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "currentVersion": {
        "type": "string"
      },
      "covers": {
        "type": "array",
        "description": "Track segments covered by the scenario.",
        "items": { "$ref": "scenario.schema.json#/definitions/TrackSegment" }
      },
      "versions": {
        "type": "array"
      }
    }
  }
}
