# Local development only. Do not reuse this password outside Docker.
POSTGRES_PASSWORD=metro

# Optional: change when port 5432 is already in use on your machine.
POSTGRES_PORT=5432

# The application connects as metro_app, which cannot change the incident log.
# The seed scripts and Flyway connect as the owner (metro) instead.
# A database created before the metro_app role existed has to be rebuilt with
# `npm run db:reset`; see "Database roles" in COMMANDS.md.
DATABASE_URL=postgresql://metro_app:metro_app@localhost:5432/metro

# Used by the Vite web proxy and native app.
API_URL=http://localhost:3000

# Needed only when the browser app is hosted on a different origin from the API.
# Comma-separated browser origins permitted to open a Socket.IO connection.
WEB_ORIGIN=http://localhost:5173

# Local Vite development only. The deployed browser app uses its own origin.
VITE_SOCKET_URL=http://localhost:3000

# Required secret for signing login tokens. `npm run setup` generates a local
# value when this is blank. Each deployed environment needs its own value.
# To generate one manually: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=


MEASURE_LATENCY_API_URL=http://localhost:3000