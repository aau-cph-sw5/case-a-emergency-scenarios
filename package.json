{
  "name": "case-a-emergency-scenarios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "stub": "node stub-server/server.js",
    "stub:prism": "prism mock contracts/v1/openapi.yaml",
    "validate": "node scripts/validate-fixtures.js",
    "seed:accounts": "node scripts/seed-test-accounts.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,yml,yaml}\"",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/**/*.test.{js,mjs}\"",
    "test:integration": "node --test \"tests/integration/**/*.test.{js,mjs}\"",
    "db:up": "docker compose up -d db",
    "db:migrate": "docker compose run --rm flyway migrate",
    "db:info": "docker compose run --rm flyway info",
    "db:validate": "docker compose run --rm flyway validate",
    "db:down": "docker compose down",
    "seed": "tsx scripts/seed-scenarios.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.1",
    "@eslint/js": "^10.0.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15"
  }
}
