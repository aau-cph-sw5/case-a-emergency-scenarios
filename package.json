{
  "name": "case-a-emergency-scenarios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "contracts",
    "fixtures",
    "stub-server",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "stub": "turbo run dev --filter=@case-a/stub-server",
    "stub:prism": "prism mock contracts/v1/openapi.yaml",
    "validate": "turbo run validate",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,yml,yaml}\"",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.1",
    "@eslint/js": "^10.0.1",
    "@stoplight/prism-cli": "^5.14.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2"
  }
}
