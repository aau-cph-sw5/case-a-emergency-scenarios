{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "validate": {
      "dependsOn": ["^validate"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
